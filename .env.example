# Copy to .env (git-ignored) and adjust. docker compose reads .env for docker-compose.yml.

# Extra hostname the Docker Vite dev server accepts besides localhost and IP addresses,
# e.g. this PC's LAN name, to open http://<pc-name>:5173/ from another machine.
# Empty keeps Vite's default host check.
VITE_EXTRA_ALLOWED_HOST=

# Docker network of the backend compose project (the one running image-scoring-postgres).
# Check with: docker network ls
PIPELINE_COMPOSE_NETWORK=image-scoring-pipeline_default

# Host folder with the photo library, mounted at /mnt/d/Photos in the container.
# Docker Desktop on Windows needs a Windows path (D:/Photos); /mnt/d/Photos works only
# when docker compose runs inside WSL. A wrong path mounts an empty folder.
PHOTOS_BIND_SOURCE=D:/Photos
